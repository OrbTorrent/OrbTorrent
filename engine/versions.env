# Pinned sources for the bundled qBittorrent engine (qbittorrent-nox).
#
# Versions mirror the official qBittorrent 5.2.3 macOS release
# (Qt 6.10.3, libtorrent 1.2.20, Boost 1.86.0); OpenSSL is the 3.6 patch release.
# Every archive is verified against the SHA-256 below before it is unpacked.
# Upstream sources of each checksum are noted so they can be re-verified.

QBITTORRENT_VERSION=5.2.3
QBITTORRENT_URL=https://downloads.sourceforge.net/project/qbittorrent/qbittorrent/qbittorrent-5.2.3/qbittorrent-5.2.3.tar.xz
