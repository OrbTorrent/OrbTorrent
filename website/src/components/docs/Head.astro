---
// Starlight's head, with Geist loaded as the rest of the site loads it:
// preloaded, and used only if it arrives in time, so text never reflows as
// it swaps in. And the site's page counter.
import Default from "@astrojs/starlight/components/Head.astro";
import Analytics from "../Analytics.astro";
import geist from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
---

<Default />
<link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={`@font-face{font-family:"Geist Variable";font-style:normal;font-weight:100 900;font-display:optional;src:url(${geist}) format("woff2-variations");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`} />
<Analytics />
