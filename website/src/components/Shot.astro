---
// A screenshot of the app, as sharp as the screen allows, in modern formats.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** The width it's shown at, at most, in CSS pixels. */
  width: number;
  class?: string;
  eager?: boolean;
  /** How wide it's shown, when that isn't simply the page's width. */
  sizes?: string;
  /** "high" for the page's main picture; "low" for one that's only background. */
  priority?: "high" | "low";
}
const { src, alt, width, class: className, eager = false, sizes, priority } = Astro.props;
// Enough sizes that phones and every screen density get one close to what they need.
const widths = [0.4, 0.6, 0.8, 1, 1.4, 2]
  .map((k) => Math.min(Math.round(width * k), src.width))
  .filter((w, i, all) => all.indexOf(w) === i);
---

<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes ?? `(max-width: ${width + 64}px) calc(100vw - 2.5rem), ${width}px`}
  formats={["avif", "webp"]}
  fallbackFormat={src.format === "png" ? "png" : "jpg"}
  quality={82}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={priority}
  decoding="async"
  class={className}
/>
