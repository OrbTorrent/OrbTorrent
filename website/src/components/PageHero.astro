---
// A page's opening: the heading on the left, a longer thought in serif on
// the right, as a broadsheet sets it.
interface Props {
  label: string;
  title: string;
  /** The heading's second half, in pencil. */
  tone?: string;
  dot?: string;
}
const { label, title, tone, dot } = Astro.props;
---

<header class="page-hero wrap inset">
  <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-16">
    <div>
      <p class="label label-dot reveal" style={dot ? `--dot: ${dot}` : undefined}>{label}</p>
      <h1 class="title mt-5 reveal">{title}{tone && <> <span class="tone">{tone}</span></>}</h1>
    </div>
    {Astro.slots.has("default") && <div class="serif reveal" style="--delay: 0.08s"><slot /></div>}
  </div>
</header>

<style>
  .page-hero {
    padding-top: clamp(8rem, 17vh, 10.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }
  .title {
    font-size: clamp(2.5rem, 1.3rem + 3.9vw, 4.4rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }
</style>
