---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import LiveOrb from "../components/LiveOrb.astro";
import DownloadButton from "../components/DownloadButton.astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Check from "@lucide/astro/icons/check";
import Copy from "@lucide/astro/icons/copy";
import { site } from "../lib/site";
import { application, breadcrumbs, graph, organization } from "../lib/schema";

const brew = "brew install orbtorrent/tap/orbtorrent";
const schema = graph(organization, application, breadcrumbs([{ name: "Download", path: "/download" }]));
const steps = [
  { title: "Open the disk image", body: "Open the disk image you downloaded." },
  { title: "Drag it to Applications", body: "Drag OrbTorrent into the Applications folder." },
  { title: "Open OrbTorrent", body: "Click Open when macOS checks, the first time. It offers to bring your downloads over, and to open your magnet links and .torrent files." },
];
---

<Base
  title="Download OrbTorrent for Mac"
  description="Download OrbTorrent, the free, open-source torrent app made for the Mac. One universal app for macOS 26 or later, on Apple silicon and Intel."
  schema={schema}
>
  <PageHero label="Download" title="Get OrbTorrent" tone="for your Mac.">
    One universal app for {site.requirements}, on Apple silicon and Intel. Free, with no account and no ads.
  </PageHero>

  <section class="wrap">
    <div class="stage get reveal">
      <div class="get-text">
        <img src="/icon-192.png" alt="" width="72" height="72" class="app-icon" />
        <p class="mt-6 text-2xl font-medium tracking-tight">OrbTorrent</p>
        <p class="mt-1.5 text-[0.9375rem] text-[var(--ink-2)]">
          Universal disk image for Apple silicon and Intel
        </p>
        <DownloadButton href={site.download} tone="light" class="mt-8" />
        <p class="mt-6 text-sm text-[var(--ink-3)]">
          Or with <a class="link" href="/docs/get-started/install#with-homebrew">Homebrew</a>:
        </p>
        <div class="brew mt-2">
          <code>{brew}</code>
          <button type="button" class="brew-copy" data-copy={brew} aria-label="Copy the command">
            <Copy size={15} class="copy-icon" aria-hidden="true" />
            <Check size={15} class="copied-icon" aria-hidden="true" />
          </button>
          <span class="copied" role="status"></span>
        </div>
        <p class="mt-5 text-sm text-[var(--ink-3)]">
          Release notes and earlier versions are on <a class="link" href={site.releases}>GitHub</a>.
        </p>
      </div>
      <div class="get-orb" aria-hidden="true"><LiveOrb size="clamp(9rem, 22vw, 15rem)" /></div>
    </div>
  </section>

  <div class="rule mt-20"></div>

  <section class="wrap inset pt-16">
    <h2 class="heading reveal">Install it</h2>
  </section>
  <ol class="wrap cells cells-3 mt-10 reveal">
    {steps.map((step, index) => (
      <li class="cell">
        <span class="cell-number">{index + 1}</span>
        <h3 class="mt-5 text-[1.0625rem] font-medium tracking-tight">{step.title}</h3>
        <p class="mt-2 text-[0.9375rem] muted">{step.body}</p>
      </li>
    ))}
  </ol>

  <section class="wrap inset pt-16 grid gap-6 lg:grid-cols-2">
    <div class="dossier p-7 sm:p-9 reveal">
      <p class="label">What it needs</p>
      <dl class="facts mt-6">
        <div><dt class="label">macOS</dt><dd>26 (Tahoe) or later</dd></div>
        <div><dt class="label">Mac</dt><dd>Apple silicon or Intel</dd></div>
        <div><dt class="label">Price</dt><dd>Free and open source</dd></div>
        <div><dt class="label">Updates</dt><dd>Signed, and installed while you're not using it</dd></div>
      </dl>
    </div>
    <div class="grid gap-6 content-start reveal" style="--delay: 0.06s">
      <div class="panel p-7">
        <p class="label">Uninstall it</p>
        <p class="mt-3 muted">
          Quit OrbTorrent and drag it to the Trash. Your library and settings are in <code class="kbd">~/Library/Application Support/OrbTorrent</code>, if you'd like them gone too. Your downloaded files stay where they are.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap inset pt-16">
    <a href="/switch" class="switch art art-peach reveal">
      <span>
        <span class="label">Switching</span>
        <span class="block mt-3 text-xl font-medium tracking-tight">Coming from Transmission or qBittorrent?</span>
        <span class="block mt-1 muted">Your downloads and settings come over in one step, progress and all.</span>
      </span>
      <span class="switch-arrow"><ArrowRight size={20} /></span>
    </a>
  </section>
</Base>

<script>
  // Copies the Homebrew command, and says so for two seconds.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const box = button.parentElement!;
    const status = box.querySelector<HTMLElement>("[role=status]")!;
    let timers: number[] = [];
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
      } catch {
        // Without the clipboard, select the command to copy by hand.
        const code = box.querySelector("code");
        if (code) getSelection()?.selectAllChildren(code);
        return;
      }
      timers.forEach(clearTimeout);
      box.dataset.copied = "";
      status.textContent = "Copied";
      timers = [
        window.setTimeout(() => delete box.dataset.copied, 2000),
        // Once it's faded, so the next copy is announced again.
        window.setTimeout(() => (status.textContent = ""), 2300),
      ];
    });
  }
</script>

<style>
  .get {
    display: grid;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 3.75rem);
    min-height: 26rem;
    align-items: center;
  }
  @media (min-width: 820px) {
    .get { grid-template-columns: 1fr auto; padding-right: clamp(3rem, 8vw, 7rem); }
  }
  .get-orb { justify-self: center; }
  .app-icon { filter: drop-shadow(0 10px 30px rgb(56 133 255 / 0.45)); }
  /* The Homebrew command, with its copy button. One click on the command
     selects all of it too, to copy without the button. */
  .brew {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    max-width: 100%;
    padding: 0.3rem 0.3rem 0.3rem 0.85rem;
    border-radius: 0.6rem;
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .brew code {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink);
    overflow-wrap: anywhere;
    user-select: all;
  }
  .brew-copy {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 0.45rem;
    color: var(--ink-3);
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
  }
  .brew-copy:hover { color: var(--ink); background: rgb(255 255 255 / 0.08); }
  .brew-copy > :global(svg) { grid-area: 1 / 1; transition: opacity 0.2s, scale 0.2s; }
  .brew-copy > :global(.copied-icon) { opacity: 0; scale: 0.6; color: var(--color-green); }
  .brew[data-copied] :global(.copy-icon) { opacity: 0; scale: 0.6; }
  .brew[data-copied] :global(.copied-icon) { opacity: 1; scale: 1; }
  /* "Copied", just above the button, without moving anything. */
  .copied {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    right: 1.3rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.4rem;
    font-size: 0.75rem;
    white-space: nowrap;
    color: var(--ink);
    background: var(--bg-raised);
    box-shadow: inset 0 0 0 1px var(--line-2);
    opacity: 0;
    translate: 50% 0.25rem;
    pointer-events: none;
    transition: opacity 0.2s, translate 0.2s;
  }
  .copied:empty { visibility: hidden; }
  .brew[data-copied] .copied { opacity: 1; translate: 50% 0; }
  .switch {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.75rem 2rem;
  }
  .switch-arrow {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    transition: translate 0.3s var(--ease-out-soft);
  }
  .switch:hover .switch-arrow { translate: 3px 0; }
</style>
