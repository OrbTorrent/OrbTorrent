<script>
  import type { Orb, OrbState } from "../scripts/orb";

  // The orb's state, chosen with the buttons beside it. The stage's light
  // follows its colour.
  const stage = document.querySelector<HTMLElement>("[data-orb-stage]");
  const element = document.querySelector<HTMLElement & { orb?: Orb }>("#built-orb");
  if (stage && element) {
    const buttons = [...stage.querySelectorAll<HTMLButtonElement>("[data-state]")];
    for (const button of buttons) {
      button.addEventListener("click", () => {
        for (const other of buttons) other.setAttribute("aria-pressed", String(other === button));
        stage.style.setProperty("--tint", button.dataset.tint!);
        element.orb?.setState(JSON.parse(button.dataset.state!) as OrbState);
      });
    }
  }

  // The contents mark the section being read.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-section]")].map((link) => [link.dataset.section!, link]),
  );
  const headings = [...links.keys()].map((id) => document.getElementById(id)).filter((heading): heading is HTMLElement => !!heading);
  const mark = () => {
    let current = headings[0];
    for (const heading of headings) if (heading.getBoundingClientRect().top < window.innerHeight * 0.3) current = heading;
    for (const [id, link] of links) link.setAttribute("aria-current", String(id === current?.id));
  };
  let pending = false;
  addEventListener("scroll", () => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => {
      pending = false;
      mark();
    });
  }, { passive: true });
  mark();
</script>
