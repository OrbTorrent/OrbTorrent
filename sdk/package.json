{
  "name": "@orbtorrent/api",
  "version": "1.0.1",
  "description": "Build extensions for OrbTorrent, the BitTorrent app for macOS: the API extensions use, and the orb command-line tool.",
  "keywords": [
    "orbtorrent",
    "extension",
    "sdk",
    "bittorrent",
    "torrent",
    "macos"
  ],
  "homepage": "https://github.com/sanjevirau/OrbTorrent/tree/main/docs/extensions#readme",
  "bugs": {
    "url": "https://github.com/sanjevirau/OrbTorrent/issues",
    "email": "help@orbtorrent.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanjevirau/OrbTorrent.git",
    "directory": "sdk"
  },
  "license": "MIT",
  "author": "Sanjevi Rau",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": "./eslint.config.js",
    "./tsconfig": "./tsconfig.extension.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "orb": "bin/orb.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "eslint.config.js",
    "tsconfig.extension.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.runtime.json && tsc -p tsconfig.cli.json",
    "test": "node --test \"test/*.test.js\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@eslint/js": "^10.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
